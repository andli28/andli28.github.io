---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Datetime from "@/components/Datetime.astro";
import Footer from "@/components/Footer.astro";
import { getLabSlug, getSortedLab } from "@/utils/getSortedLab";
import { useTranslations } from "@/i18n";
import config from "@/config";

const entries = getSortedLab(await getCollection("lab"));

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout
  title={`${t.pages.labTitle} | ${config.site.title}`}
  description={t.pages.labDesc}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.labTitle} pageDesc={t.pages.labDesc}>
    {
      entries.length === 0 ? (
        <p class="my-6 opacity-80">{t.pages.labEmpty}</p>
      ) : (
        <ul>
          {entries.map(({ id, data }) => (
            <li class="my-6">
              <a
                href={getRelativeLocaleUrl(locale, `lab/${getLabSlug(id)}`)}
                class:list={[
                  "text-accent inline-block text-lg font-medium",
                  "decoration-dashed underline-offset-4 hover:underline",
                  "focus-visible:no-underline focus-visible:underline-offset-0",
                ]}
              >
                <h2>{data.title}</h2>
              </a>
              <Datetime
                pubDatetime={data.pubDatetime}
                modDatetime={data.modDatetime}
                timezone={data.timezone}
              />
              <p>{data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </Main>

  <Footer />
</Layout>
