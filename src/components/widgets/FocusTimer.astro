---
/**
 * Full-screen focus timer: twist the dial, focus. Naming the task is optional.
 * Meant for a Lab entry with `fullscreen: true`. State lives in localStorage.
 *
 *   import FocusTimer from "@/components/widgets/FocusTimer.astro";
 *   <FocusTimer />
 */

// The dial is a fruit seen from the front: skin, an inner face with a tick
// per minute (a longer one and a numeral every five), and the fruit's own
// stem or leaves on top. Radii are in the SVG's -200..200 box.
const BODY_R = 164;
const FACE_R = 128;
const polar = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return [+(r * Math.sin(a)).toFixed(2), +(-r * Math.cos(a)).toFixed(2)];
};
const ticks = Array.from({ length: 60 }, (_, i) => {
  const major = i % 5 === 0;
  const [x1, y1] = polar(i * 6, 121);
  const [x2, y2] = polar(i * 6, major ? 110 : 116);
  return { major, x1, y1, x2, y2 };
});
const numerals = Array.from({ length: 12 }, (_, i) => {
  const [x, y] = polar(i * 30, 98);
  return { n: i * 5, x, y };
});
// Watermelon: dark stripes on the rind, seeds that show inside the wedge.
const stripes = Array.from({ length: 12 }, (_, i) => {
  const [x1, y1] = polar(i * 30 + 15, FACE_R);
  const [x2, y2] = polar(i * 30 + 15, BODY_R + 10);
  return { x1, y1, x2, y2 };
});
const seeds = [20, 62, 104, 146, 188, 230, 272, 314].map((deg, i) => {
  const [x, y] = polar(deg, i % 2 ? 46 : 68);
  return { x, y, rot: deg };
});
// Inside each fruit, shown only within the wedge (the "flesh"): tomato
// seeds, orange segments, apple pips.
const tomatoSeeds = Array.from({ length: 15 }, (_, i) => {
  const deg = i * 24 + 6;
  const [x, y] = polar(deg, i % 2 ? 58 : 76);
  return { x, y, rot: deg };
});
const segments = Array.from({ length: 10 }, (_, i) => {
  const [x1, y1] = polar(i * 36, 44);
  const [x2, y2] = polar(i * 36, 112);
  return { x1, y1, x2, y2 };
});
const pips = [36, 108, 180, 252, 324].map(deg => {
  const [x, y] = polar(deg, 62);
  return { x, y, rot: deg };
});
// Tomato: five sepals around the stem.
const sepals = [-54, 18, 90, 162, 234];

// Their icons are drawn by the script from the dial itself, so they match.
const FRUITS = ["tomato", "orange", "apple", "watermelon"];
---

<div class="ft" data-mode="focus" data-state="idle" data-fruit="tomato">
  <div class="ft-glow" data-ft="glow-focus" aria-hidden="true"></div>
  <div class="ft-glow ft-glow-break" data-ft="glow-break" aria-hidden="true">
  </div>

  <p class="ft-toast" data-ft="toast" role="status" aria-live="polite"></p>

  <!-- Next to the back link, so the right-hand pills keep their width and
       the top-center message has room. -->
  <div class="ft-top ft-top-left">
    <button
      type="button"
      class="ft-pill ft-fruit-pill"
      data-ft="fruit-btn"
      aria-expanded="false"
      aria-controls="ft-fruit-panel"
      aria-label="Fruit: tomato"
    >
      <span class="ft-fruit-art" data-ft="fruit-icon" aria-hidden="true"></span>
    </button>
  </div>

  <div class="ft-top">
    <button
      type="button"
      class="ft-pill"
      data-ft="plan-btn"
      aria-expanded="false"
      aria-controls="ft-plan-panel"
    >
      plan
    </button>
    <button
      type="button"
      class="ft-pill"
      data-ft="settings-btn"
      aria-expanded="false"
      aria-controls="ft-panel"
    >
      settings
    </button>
    <button
      type="button"
      class="ft-pill"
      data-ft="mini-btn"
      aria-pressed="false"
      title="Keep a small timer on top of your other windows"
      hidden
    >
      pop out
    </button>
    <button type="button" class="ft-pill" data-ft="sound" aria-pressed="false">
      sound: off
    </button>
  </div>

  <div
    class="ft-panel ft-fruit-panel"
    id="ft-fruit-panel"
    data-ft="fruit-panel"
    data-open="false"
    role="dialog"
    aria-label="Choose a fruit"
  >
    <div class="ft-fruit-grid" role="group" aria-label="Fruit">
      {
        FRUITS.map(f => (
          <button type="button" data-ft-fruit={f} aria-pressed="false">
            <span class="ft-fruit-art" aria-hidden="true" />
            <span>{f}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div
    class="ft-panel ft-plan-panel"
    id="ft-plan-panel"
    data-ft="plan-panel"
    data-open="false"
    role="dialog"
    aria-label="Plan your time"
  >
    <label class="ft-plan-until">
      <span>free until</span>
      <input type="time" data-ft="plan-end" />
    </label>
    <div class="ft-plan-quick">
      <button type="button" data-plan-add="-30" aria-label="30 minutes earlier"
        >−30m</button
      >
      <button type="button" data-plan-add="30" aria-label="30 minutes later"
        >+30m</button
      >
      <button type="button" data-plan-add="60" aria-label="1 hour later"
        >+1h</button
      >
      <button type="button" data-plan-add="120" aria-label="2 hours later"
        >+2h</button
      >
    </div>
    <div class="ft-plan-summary" data-ft="plan-summary" aria-live="polite">
    </div>
    <div class="ft-panel-actions">
      <button type="button" data-ft="plan-clear" hidden>clear plan</button>
      <button type="button" class="ft-plan-go" data-ft="plan-go">
        start plan
      </button>
    </div>
  </div>

  <div
    class="ft-panel"
    id="ft-panel"
    data-ft="panel"
    data-open="false"
    role="dialog"
    aria-label="Timer settings"
  >
    <label>
      <span>focus</span>
      <input
        type="number"
        inputmode="numeric"
        min="1"
        max="180"
        data-ft-set="focus"
      />
      <small>min</small>
    </label>
    <label>
      <span>short break</span>
      <input
        type="number"
        inputmode="numeric"
        min="1"
        max="60"
        data-ft-set="short"
      />
      <small>min</small>
    </label>
    <label>
      <span>long break</span>
      <input
        type="number"
        inputmode="numeric"
        min="1"
        max="90"
        data-ft-set="long"
      />
      <small>min</small>
    </label>
    <label>
      <span>long break every</span>
      <input
        type="number"
        inputmode="numeric"
        min="2"
        max="12"
        data-ft-set="every"
      />
      <small>sessions</small>
    </label>
    <label class="ft-check">
      <input type="checkbox" data-ft="notify" />
      <span>notify me when a block ends</span>
    </label>
    <div class="ft-panel-actions">
      <button type="button" data-ft="reset-today">reset today</button>
      <button type="button" data-ft="clear-history">clear history</button>
    </div>
  </div>

  <div class="ft-stage">
    <div class="ft-tabs" role="group" aria-label="Mode">
      <button type="button" data-ft-mode="focus" aria-pressed="true">
        focus
        <span class="ft-cycle" data-ft="cycle"></span>
      </button>
      <button type="button" data-ft-mode="short" aria-pressed="false">
        short break
      </button>
      <button type="button" data-ft-mode="long" aria-pressed="false">
        long break
      </button>
    </div>

    <div class="ft-dial" data-ft="dial">
      <svg viewBox="-200 -200 400 400" aria-hidden="true">
        <defs>
          <clipPath id="ft-body-clip">
            <circle r={BODY_R}></circle>
          </clipPath>
          <clipPath id="ft-wedge-clip">
            <use href="#ft-wedge-path"></use>
          </clipPath>
        </defs>

        <!-- Stem and leaves sit behind the body, so their bases tuck in. -->
        <g data-fruit-only="tomato">
          {
            sepals.map(a => (
              <ellipse
                class="ft-leaf"
                cx="0"
                cy="-27"
                rx="14"
                ry="27"
                transform={`translate(0 ${-BODY_R + 6}) rotate(${a + 90})`}
              />
            ))
          }
          <rect
            class="ft-stem"
            x="-6"
            y={-BODY_R - 38}
            width="12"
            height="30"
            rx="6"></rect>
        </g>
        <g data-fruit-only="orange">
          <rect
            class="ft-stem"
            x="-5"
            y={-BODY_R - 16}
            width="10"
            height="24"
            rx="5"></rect>
          <ellipse
            class="ft-leaf"
            cx="26"
            cy={-BODY_R - 16}
            rx="26"
            ry="12"
            transform={`rotate(-18 4 ${-BODY_R - 8})`}></ellipse>
        </g>
        <g data-fruit-only="apple">
          <path
            class="ft-stem ft-stem-line"
            d={`M0 ${-BODY_R + 14} q 1 -26 12 -44`}></path>
          <ellipse
            class="ft-leaf"
            cx="38"
            cy={-BODY_R - 22}
            rx="26"
            ry="12"
            transform={`rotate(-24 14 ${-BODY_R - 18})`}></ellipse>
        </g>
        <g data-fruit-only="watermelon">
          <path
            class="ft-stem ft-stem-line"
            d={`M0 ${-BODY_R + 6} q -2 -16 10 -20 q 10 -3 8 -12`}></path>
        </g>

        <circle class="ft-skin-shade" r={BODY_R} cy="9"></circle>
        <circle class="ft-skin" r={BODY_R}></circle>
        <g data-fruit-only="watermelon" clip-path="url(#ft-body-clip)">
          {
            stripes.map(s => (
              <line class="ft-stripe" x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} />
            ))
          }
        </g>
        <g data-fruit-only="apple">
          <ellipse class="ft-dimple" cx="0" cy={-BODY_R + 10} rx="20" ry="7"
          ></ellipse>
        </g>
        <circle class="ft-rind" r={FACE_R + 9}></circle>
        <circle class="ft-face-shade" r={FACE_R} cy="6"></circle>
        <circle class="ft-face" r={FACE_R}></circle>
        <path class="ft-wedge" id="ft-wedge-path" data-ft="wedge"></path>
        <g data-fruit-only="watermelon" clip-path="url(#ft-wedge-clip)">
          {
            seeds.map(s => (
              <ellipse
                class="ft-seed"
                rx="3.6"
                ry="6"
                transform={`translate(${s.x} ${s.y}) rotate(${s.rot})`}
              />
            ))
          }
        </g>
        <g data-fruit-only="tomato" clip-path="url(#ft-wedge-clip)">
          {
            tomatoSeeds.map(s => (
              <ellipse
                class="ft-seed"
                rx="2.8"
                ry="4.6"
                transform={`translate(${s.x} ${s.y}) rotate(${s.rot})`}
              />
            ))
          }
        </g>
        <g data-fruit-only="orange" clip-path="url(#ft-wedge-clip)">
          {
            segments.map(s => (
              <line
                class="ft-segment"
                x1={s.x1}
                y1={s.y1}
                x2={s.x2}
                y2={s.y2}
              />
            ))
          }
        </g>
        <g data-fruit-only="apple" clip-path="url(#ft-wedge-clip)">
          {
            pips.map(s => (
              <ellipse
                class="ft-seed"
                rx="4.5"
                ry="9"
                transform={`translate(${s.x} ${s.y}) rotate(${s.rot})`}
              />
            ))
          }
        </g>
        {
          ticks.map(t => (
            <line
              class={t.major ? "ft-tick ft-major" : "ft-tick"}
              x1={t.x1}
              y1={t.y1}
              x2={t.x2}
              y2={t.y2}
            />
          ))
        }
        {
          numerals.map(n => (
            <text class="ft-num" x={n.x} y={n.y}>
              {n.n}
            </text>
          ))
        }
        <line class="ft-hand" data-ft="hand" x1="0" y1="0" x2="0" y2="-86"
        ></line>
        <circle r="42" class="ft-hub-disc"></circle>
      </svg>
      <button type="button" class="ft-hub" data-ft="hub" aria-label="Start">
        <span class="ft-time" data-ft="time" role="timer">25:00</span>
      </button>
    </div>

    <label class="ft-task">
      <span class="sr-only">What are you working on?</span>
      <input
        data-ft="task"
        type="text"
        maxlength="60"
        autocomplete="off"
        spellcheck="false"
        placeholder="what are you working on?"
      />
    </label>
    <div class="ft-recent" data-ft="recent" aria-label="Recent tasks"></div>
  </div>

  <section class="ft-strip" data-ft="strip" aria-label="Plan" hidden>
    <div class="ft-strip-head">
      <span data-ft="strip-start"></span>
      <button type="button" class="ft-replan" data-ft="replan" hidden>
        replan from now
      </button>
      <span data-ft="strip-end"></span>
    </div>
    <div class="ft-track" data-ft="track">
      <div class="ft-now" data-ft="now" aria-hidden="true"><i></i></div>
    </div>
    <div class="ft-label-editor" data-ft="label-editor" hidden>
      <span data-ft="label-time"></span>
      <input
        data-ft="label-input"
        type="text"
        maxlength="60"
        autocomplete="off"
        spellcheck="false"
        placeholder="label this block"
        aria-label="Block label"
      />
    </div>
  </section>

  <div class="ft-today" data-ft="today-wrap" hidden>
    <span class="ft-dots" data-ft="dots"></span>
    <span data-ft="total"></span>
  </div>
</div>

<script>
  import { mountFocusTimer } from "./focus-timer.js";
  const mountAll = () =>
    document.querySelectorAll<HTMLElement>(".ft").forEach(mountFocusTimer);
  mountAll();
  document.addEventListener("astro:page-load", mountAll);
</script>

<style is:global>
  /* Flat, like the Lab thumbnail, on the site's own background, light or
     dark. Each fruit sets its own skin, face and wedge; --ft-focus is its
     accent for the rest of the UI. */
  .ft {
    --ft-bg: var(--background);
    --ft-ink-rgb: 40 39 40;
    --ft-ink: rgb(var(--ft-ink-rgb));
    --ft-dim: rgb(var(--ft-ink-rgb) / 0.58);
    --ft-faint: rgb(var(--ft-ink-rgb) / 0.16);
    --ft-surface: rgb(255 255 255 / 0.96);
    --ft-shadow-rgb: 60 40 20;
    --ft-scheme: light;
    --ft-break: #2e9a6c;
    --ft-color: var(--ft-focus);
    --ft-hot: var(--ft-color);
    --ft-wedge: var(--fruit-wedge);
    --ft-ease-out: cubic-bezier(0.23, 1, 0.32, 1);

    /* tomato */
    --ft-focus: #d8432f;
    --fruit-skin: #e0503c;
    --fruit-shade: #b03a2b;
    --fruit-rind: transparent;
    --fruit-face: #ffffff;
    --fruit-face-shade: #c23f2f;
    --fruit-wedge: #f2a33a;
    /* During a break the flesh fades to a pale version of itself (the
       timeline keeps green for its break blocks). */
    --fruit-rest: #e8c392;
    --fruit-seed: #fff1c2;
    --fruit-leaf: #2e9a6c;
    --fruit-stem: #23774f;
    /* Ticks and numerals sit on the light face in either theme. */
    --fruit-ink: 40 39 40;

    --ft-dial: min(84vw, 62svh, 540px);

    position: relative;
    display: grid;
    height: 100svh;
    place-items: center;
    overflow: hidden;
    background: var(--ft-bg);
    color: var(--ft-ink);
    font-family: var(--font-google-sans-code), ui-monospace, monospace;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  [data-theme="dark"] .ft {
    --ft-ink-rgb: 234 237 243;
    --ft-surface: rgb(44 52 72 / 0.97);
    --ft-shadow-rgb: 0 0 0;
    --ft-scheme: dark;
  }
  /* The page is exactly one screen and never scrolls. */
  html:has(.ft) {
    overflow: hidden;
  }
  .ft[data-fruit="orange"] {
    --ft-focus: #e0701a;
    --fruit-skin: #ec7a1c;
    --fruit-shade: #c45f0e;
    --fruit-rind: #ffe3b3;
    --fruit-face: #fffaf0;
    --fruit-face-shade: #f0c27a;
    /* Juicy yellow-orange flesh, split by white pith. */
    --fruit-wedge: #ffbe2e;
    --fruit-rest: #f0c09a;
    --fruit-seed: #fffaf0;
    --fruit-leaf: #2e9a6c;
    --fruit-stem: #6b4226;
  }
  .ft[data-fruit="apple"] {
    --ft-focus: #c92f37;
    --fruit-skin: #d9363e;
    --fruit-shade: #a8262d;
    --fruit-rind: #fff1cf;
    --fruit-face: #fffbef;
    --fruit-face-shade: #e9d4a4;
    /* Golden flesh with brown pips, not the red of the skin. */
    --fruit-wedge: #f2b134;
    --fruit-rest: #e6cf98;
    --fruit-seed: #5b3416;
    --fruit-leaf: #2e9a6c;
    --fruit-stem: #6b4226;
  }
  .ft[data-fruit="watermelon"] {
    --ft-focus: #e0434f;
    --ft-break: #1f8a5e;
    --fruit-skin: #2e9a6c;
    --fruit-shade: #1f6e4d;
    --fruit-rind: #dff1c6;
    --fruit-face: #ffe4e1;
    --fruit-face-shade: #b9dca0;
    --fruit-wedge: #ef4b5a;
    --fruit-rest: #e8a0a4;
    --fruit-seed: #2a1c18;
    --fruit-leaf: #2e9a6c;
    --fruit-stem: #6b4226;
  }
  .ft[data-mode="break"] {
    --ft-color: var(--fruit-rest);
    --ft-wedge: var(--fruit-rest);
  }
  /* Parts that belong to one fruit only. */
  .ft [data-fruit-only] {
    display: none;
  }
  .ft[data-fruit="tomato"] [data-fruit-only="tomato"],
  .ft[data-fruit="orange"] [data-fruit-only="orange"],
  .ft[data-fruit="apple"] [data-fruit-only="apple"],
  .ft[data-fruit="watermelon"] [data-fruit-only="watermelon"] {
    display: inline;
  }
  /* The back link sits outside .ft, so it uses the site's tokens. */
  .lab-full:has(.ft) .lab-back {
    color: color-mix(in srgb, var(--foreground) 58%, transparent);
  }
  @media (hover: hover) and (pointer: fine) {
    .lab-full:has(.ft) .lab-back:hover {
      color: var(--foreground);
    }
  }
  .lab-full:has(.ft) .lab-back:focus-visible {
    color: var(--foreground);
  }

  /* Light behind the dial; dims as the session runs out. One layer per
     mode so the color can crossfade. Opacity is set from JS on each layer. */
  .ft-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 42%,
      color-mix(in srgb, var(--ft-focus) 32%, transparent) 0,
      transparent 55%
    );
    opacity: 0;
    /* Countdown drift is steady, so linear. */
    transition: opacity 1s linear;
    pointer-events: none;
  }
  .ft-glow-break {
    background: radial-gradient(
      circle at 50% 42%,
      color-mix(in srgb, var(--fruit-rest) 40%, transparent) 0,
      transparent 55%
    );
  }
  /* Start, pause, reset, mode change: respond right away. */
  .ft-glow.is-shifting {
    transition: opacity 300ms var(--ft-ease-out);
  }

  .ft-top {
    position: absolute;
    top: 0.85rem;
    right: 1rem;
    /* Above the stage, which spans the full height and can reach under
       the pills on narrower windows. */
    z-index: 6;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8rem;
  }
  .ft-pill {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--ft-faint);
    border-radius: 999px;
    color: var(--ft-dim);
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }
  .ft-top.ft-top-left {
    right: auto;
    left: 5rem;
  }
  .ft-fruit-pill {
    display: grid;
    place-items: center;
    padding: 0.2rem 0.5rem;
  }
  /* Copies of the dial's fruit (drawn by the script), 360 x 394. */
  .ft-fruit-art {
    display: block;
    width: 1.15rem;
    aspect-ratio: 360 / 394;
  }
  .ft-fruit-art svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Fruit picker: a row of four, each a little fruit with its name. */
  .ft-panel.ft-fruit-panel {
    right: auto;
    left: 1rem;
    width: min(20rem, calc(100vw - 2rem));
  }
  .ft-fruit-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.35rem;
  }
  .ft-fruit-grid button {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    padding: 0.55rem 0.2rem 0.45rem;
    border: 1px solid transparent;
    border-radius: 10px;
    color: var(--ft-dim);
    font-size: 0.72rem;
    transition:
      color 150ms ease,
      border-color 150ms ease,
      background-color 150ms ease,
      transform 140ms var(--ft-ease-out);
  }
  .ft-fruit-grid .ft-fruit-art {
    width: 1.9rem;
  }
  .ft-fruit-grid button[aria-pressed="true"] {
    border-color: var(--ft-faint);
    background: rgb(var(--ft-ink-rgb) / 0.05);
    color: var(--ft-ink);
  }
  .ft-fruit-grid button[data-pressed] {
    transform: scale(0.97);
  }
  .ft-fruit-grid button:focus-visible {
    outline: 2px solid var(--ft-dim);
    outline-offset: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .ft-fruit-grid button:hover {
      color: var(--ft-ink);
    }
  }

  /* Settings panel: anchored under its pill, so it grows from that corner. */
  .ft-panel {
    position: absolute;
    top: 3.1rem;
    right: 1rem;
    z-index: 5;
    display: grid;
    gap: 0.6rem;
    width: min(17.5rem, calc(100vw - 2rem));
    padding: 0.9rem 1rem;
    border: 1px solid var(--ft-faint);
    border-radius: 12px;
    background: var(--ft-surface);
    box-shadow: 0 18px 40px rgb(var(--ft-shadow-rgb) / 0.14);
    font-size: 0.8rem;
    opacity: 0;
    transform: scale(0.96);
    transform-origin: top right;
    visibility: hidden;
    transition:
      opacity 120ms ease-out,
      transform 120ms ease-out,
      visibility 0s linear 120ms;
  }
