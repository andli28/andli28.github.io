---
/**
 * Full-screen focus timer: name a task, twist the dial, focus.
 * Meant for a Lab entry with `fullscreen: true`. State lives in localStorage.
 *
 *   import FocusTimer from "@/components/widgets/FocusTimer.astro";
 *   <FocusTimer />
 */

// Static dial face: a tick per minute, a longer one and a numeral every five.
const ticks = Array.from({ length: 60 }, (_, i) => {
  const major = i % 5 === 0;
  const a = (i / 60) * Math.PI * 2;
  const r1 = 182;
  const r2 = major ? 168 : 175;
  return {
    major,
    x1: +(r1 * Math.sin(a)).toFixed(2),
    y1: +(-r1 * Math.cos(a)).toFixed(2),
    x2: +(r2 * Math.sin(a)).toFixed(2),
    y2: +(-r2 * Math.cos(a)).toFixed(2),
  };
});
const numerals = Array.from({ length: 12 }, (_, i) => {
  const a = (i / 12) * Math.PI * 2;
  return {
    n: i * 5,
    x: +(152 * Math.sin(a)).toFixed(2),
    y: +(-152 * Math.cos(a)).toFixed(2),
  };
});
---

<div class="ft" data-mode="focus" data-state="idle">
  <div class="ft-glow" data-ft="glow-focus" aria-hidden="true"></div>
  <div class="ft-glow ft-glow-break" data-ft="glow-break" aria-hidden="true">
  </div>

  <div class="ft-top">
    <span class="ft-status" data-ft="status">focus · 1 of 4</span>
    <button type="button" class="ft-pill" data-ft="sound" aria-pressed="true">
      sound: on
    </button>
  </div>

  <div class="ft-stage">
    <div class="ft-dial" data-ft="dial">
      <svg viewBox="-200 -200 400 400" aria-hidden="true">
        <defs>
          <radialGradient id="ft-face" cx="50%" cy="38%" r="70%">
            <stop offset="0" stop-color="#1f1f23"></stop>
            <stop offset="1" stop-color="#121214"></stop>
          </radialGradient>
          <radialGradient id="ft-wedge" cx="50%" cy="50%" r="50%">
            <stop offset="0.2" stop-color="var(--ft-hot)"></stop>
            <stop offset="1" stop-color="var(--ft-color)"></stop>
          </radialGradient>
          <radialGradient id="ft-hub" cx="40%" cy="30%" r="80%">
            <stop offset="0" stop-color="#3a3a40"></stop>
            <stop offset="1" stop-color="#1a1a1d"></stop>
          </radialGradient>
        </defs>
        <circle class="ft-rim" r="196"></circle>
        <circle r="190" fill="url(#ft-face)"></circle>
        <path class="ft-wedge" data-ft="wedge" fill="url(#ft-wedge)"></path>
        {
          ticks.map(t => (
            <line
              class={t.major ? "ft-tick ft-major" : "ft-tick"}
              x1={t.x1}
              y1={t.y1}
              x2={t.x2}
              y2={t.y2}
            />
          ))
        }
        {
          numerals.map(n => (
            <text class="ft-num" x={n.x} y={n.y}>
              {n.n}
            </text>
          ))
        }
        <line class="ft-hand" data-ft="hand" x1="0" y1="0" x2="0" y2="-132"
        ></line>
        <circle r="52" fill="url(#ft-hub)" class="ft-hub-disc"></circle>
      </svg>
      <button type="button" class="ft-hub" data-ft="hub" aria-label="Start">
        <span class="ft-time" data-ft="time" role="timer">25:00</span>
      </button>
    </div>

    <label class="ft-task">
      <span class="sr-only">What are you working on?</span>
      <input
        data-ft="task"
        type="text"
        maxlength="60"
        autocomplete="off"
        spellcheck="false"
        list="ft-recent"
        placeholder="what are you working on?"
      />
      <datalist id="ft-recent" data-ft="recent"></datalist>
    </label>
  </div>

  <div class="ft-today" data-ft="today-wrap" hidden>
    <span class="ft-dots" data-ft="dots"></span>
    <span data-ft="total"></span>
  </div>

  <p class="ft-hint">name it · twist the dial · tap to pause</p>
</div>

<script>
  import { mountFocusTimer } from "./focus-timer.js";
  const mountAll = () =>
    document.querySelectorAll<HTMLElement>(".ft").forEach(mountFocusTimer);
  mountAll();
  document.addEventListener("astro:page-load", mountAll);
</script>

<style is:global>
  .ft {
    --ft-bg: #0b0b0d;
    --ft-ink: #ece8e1;
    --ft-dim: rgb(236 232 225 / 0.45);
    --ft-faint: rgb(236 232 225 / 0.18);
    --ft-color: #e8542e;
    --ft-hot: #ff9a5c;
    --ft-ease-out: cubic-bezier(0.23, 1, 0.32, 1);

    position: relative;
    display: grid;
    min-height: 100svh;
    place-items: center;
    overflow: hidden;
    background: var(--ft-bg);
    color: var(--ft-ink);
    font-family: var(--font-google-sans-code), ui-monospace, monospace;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .ft[data-mode="break"] {
    --ft-color: #1e9e8f;
    --ft-hot: #7fe0c9;
  }

  /* Light behind the dial; dims as the session runs out. One layer per
     mode so the color can crossfade. Opacity is set from JS on each layer. */
  .ft-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 42%,
      rgb(232 84 46 / 0.32) 0,
      transparent 55%
    );
    opacity: 0;
    /* Countdown drift is steady, so linear. */
    transition: opacity 1s linear;
    pointer-events: none;
  }
  .ft-glow-break {
    background: radial-gradient(
      circle at 50% 42%,
      rgb(30 158 143 / 0.32) 0,
      transparent 55%
    );
  }
  /* Start, pause, reset, mode change: respond right away. */
  .ft-glow.is-shifting {
    transition: opacity 300ms var(--ft-ease-out);
  }

  .ft-top {
    position: absolute;
    top: 0.85rem;
    right: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8rem;
  }
  .ft-status {
    color: var(--ft-dim);
  }
  .ft-pill {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--ft-faint);
    border-radius: 999px;
    color: var(--ft-dim);
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .ft-stage {
    position: relative;
    display: grid;
    justify-items: center;
    gap: clamp(1.5rem, 4vh, 2.75rem);
    padding: 4rem 1rem 6rem;
  }

  .ft-dial {
    position: relative;
    width: min(78vw, 58svh, 460px);
    aspect-ratio: 1;
    touch-action: none;
    cursor: grab;
  }
  /* Static shadow layer: drawn once, not re-blurred when the wedge changes. */
  .ft-dial::before {
    position: absolute;
    inset: 1%;
    border-radius: 50%;
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.6);
    content: "";
    pointer-events: none;
  }
  .ft-dial.is-dragging {
    cursor: grabbing;
  }
  .ft-dial svg {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .ft-rim {
    fill: #1b1b1e;
    stroke: rgb(255 255 255 / 0.06);
    stroke-width: 1;
  }
  .ft-wedge {
    filter: drop-shadow(
      0 0 18px color-mix(in srgb, var(--ft-color) 60%, transparent)
    );
  }
  .ft-tick {
    stroke: rgb(236 232 225 / 0.22);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .ft-major {
    stroke: rgb(236 232 225 / 0.6);
    stroke-width: 2.5;
  }
  .ft-num {
    fill: rgb(236 232 225 / 0.55);
    font-size: 13px;
    text-anchor: middle;
    dominant-baseline: central;
  }
  .ft-hand {
    stroke: var(--ft-ink);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.85;
  }
  .ft-hub-disc {
    stroke: rgb(255 255 255 / 0.08);
    stroke-width: 1;
  }

  .ft-hub {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 27%;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: transform 160ms var(--ft-ease-out);
  }
  .ft-hub:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--ft-color) 70%, transparent);
    outline-offset: 4px;
  }
  .ft-pill:focus-visible {
    outline: 2px solid var(--ft-dim);
    outline-offset: 2px;
  }
  /* Set on pointer presses only, so keyboard toggles stay instant. */
  .ft-hub[data-pressed] {
    transform: translate(-50%, -50%) scale(0.96);
  }
  .ft-time {
    font-size: clamp(0.95rem, 3.6vmin, 1.35rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    transition: opacity 200ms ease;
  }
  .ft[data-state="paused"] .ft-time {
    opacity: 0.5;
  }

  .ft-task input {
    width: min(86vw, 560px);
    border: 0;
    background: transparent;
    color: var(--ft-ink);
    font-family: "Iowan Old Style", "New York", ui-serif, Georgia, serif;
    font-size: clamp(1.4rem, 4.2vw, 2.1rem);
    font-style: italic;
    text-align: center;
    caret-color: var(--ft-color);
    user-select: text;
    outline: none;
  }
  .ft-task input::placeholder {
    color: rgb(236 232 225 / 0.28);
    transition: color 200ms ease;
  }
  .ft-task input[readonly] {
    cursor: default;
  }
  .ft.needs-task .ft-task input::placeholder {
    color: var(--ft-hot);
  }

  .ft-today {
    position: absolute;
    bottom: 1.1rem;
    left: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ft-dim);
    font-size: 0.75rem;
  }
  .ft-dots {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    max-width: 40vw;
  }
  .ft-dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e8542e;
  }

  .ft-hint {
    position: absolute;
    right: 1rem;
    bottom: 1.1rem;
    left: 1rem;
    color: rgb(236 232 225 / 0.35);
    font-size: 0.75rem;
    text-align: center;
    pointer-events: none;
  }
  .ft-today:not([hidden]) ~ .ft-hint {
    bottom: 2.6rem;
  }
  @media (min-width: 720px) {
    .ft-today:not([hidden]) ~ .ft-hint {
      bottom: 1.1rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .ft-pill:hover {
      border-color: var(--ft-dim);
      color: var(--ft-ink);
    }
  }
  /* Opacity fades stay (nothing moves); the press scale goes. */
  @media (prefers-reduced-motion: reduce) {
    .ft-hub {
      transition: none;
    }
    .ft-hub[data-pressed] {
      transform: translate(-50%, -50%);
    }
  }
</style>
