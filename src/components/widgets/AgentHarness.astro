---
/**
 * Harness: build the harness around a model, one job and one part at a time.
 * Meant for a Lab entry with `fullscreen: true`. Progress lives in
 * localStorage. The board is built by harness/ui.js.
 *
 *   import AgentHarness from "@/components/widgets/AgentHarness.astro";
 *   <AgentHarness />
 */
---

<div class="ah">
  <noscript>This game needs JavaScript.</noscript>
</div>

<script>
  import { mountHarness } from "./harness/ui.js";
  const mountAll = () =>
    document.querySelectorAll<HTMLElement>(".ah").forEach(mountHarness);
  document.addEventListener("astro:page-load", mountAll);
  mountAll();
</script>

<style is:global>
  .ah {
    --ah-bg: #efeeea;
    --ah-card: #f8f7f4;
    --ah-ink: #24262b;
    --ah-mute: #868990;
    --ah-tile: #ffffff;
    --ah-edge: #d3d1c9;
    --ah-line: #e2e0d9;
    --ah-accent: #4b5bdc;
    --ah-accent-edge: #3441a8;
    --ah-on-accent: #ffffff;
    --ah-red: #df4f3c;
    --ah-amber: #e3a21c;
    --ah-green: #2c9a6a;
    --ah-blue: #3486cf;
    --ah-task: #f4c430;
    --ah-g0: #ef476f;
    --ah-g1: #06a77d;
    --ah-g2: #118ab2;
    --ah-g3: #8f5fd7;
    --ah-g4: #f08c00;
    --ah-ease: cubic-bezier(0.23, 1, 0.32, 1);

    position: relative;
    min-height: 100svh;
    background: var(--ah-bg);
    color: var(--ah-ink);
    font-family:
      ui-rounded,
      "SF Pro Rounded",
      "Nunito",
      system-ui,
      -apple-system,
      "Segoe UI",
      sans-serif;
    font-size: 15px;
    line-height: 1.4;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
    overflow-x: clip;
  }
  [data-theme="dark"] .ah {
    --ah-bg: #15171c;
    --ah-card: #1b1e25;
    --ah-ink: #eceef2;
    --ah-mute: #8b909b;
    --ah-tile: #272b35;
    --ah-edge: #0d0f13;
    --ah-line: #2c313c;
    --ah-accent: #6c7bff;
    --ah-accent-edge: #4250c9;
    --ah-task: #d9aa1e;
  }
  .lab-full:has(.ah) .lab-back {
    color: var(--ah-mute, #868990);
    position: absolute;
  }
  .lab-full:has(.ah) .lab-back:hover {
    color: #4b5bdc;
  }

  .ah button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .ah button:disabled {
    cursor: default;
  }
  .ah :focus-visible {
    outline: 2px solid var(--ah-accent);
    outline-offset: 2px;
  }
  .ah [hidden] {
    display: none !important;
  }
  .ah .ah-i {
    width: 1.35em;
    height: 1.35em;
    flex: none;
  }

  .ah-wrap {
    box-sizing: border-box;
    min-height: 100svh;
    padding: 10px 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* ---- header ---- */
  .ah-head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-left: 62px;
  }
  .ah-name {
    margin: 0;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .ah-pager {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-right: auto;
  }
  .ah-round:disabled {
    opacity: 0.35;
  }
  .ah-tools {
    display: flex;
    gap: 6px;
  }
  .ah-round {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--ah-tile) !important;
    box-shadow: 0 2px 0 var(--ah-edge);
    color: var(--ah-mute) !important;
    transition: transform 120ms var(--ah-ease);
  }
  .ah-round:active {
    transform: translateY(2px);
    box-shadow: none;
  }
  /* a "+1" that shows only while a new note lands */
  .ah-round.ah-bump::after {
    content: "+1";
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 8px;
    background: var(--ah-accent);
    color: var(--ah-on-accent);
    font-size: 10px;
    font-weight: 700;
    line-height: 16px;
    animation: ah-plus 2200ms ease-out both;
  }
  @keyframes ah-plus {
    0% {
      opacity: 0;
      transform: translateY(6px) scale(0.6);
    }
    12%,
    75% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }
  .ah-marquee {
    position: absolute;
    z-index: 5;
    border: 1.5px solid var(--ah-accent);
    border-radius: 6px;
    background: color-mix(in srgb, var(--ah-accent) 12%, transparent);
    pointer-events: none;
  }
  .ah-part.ah-lit {
    outline: 3px solid var(--ah-accent) !important;
    outline-offset: 2px;
  }

  /* ---- request, board ---- */
  .ah-top {
    text-align: center;
  }
  .ah-ask {
    margin: 0 auto;
    max-width: 46ch;
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.25;
    text-wrap: balance;
  }
  .ah-tip {
    margin: 4px auto 0;
    min-height: 1.4em;
    max-width: 60ch;
    color: var(--ah-mute);
    font-weight: 600;
    text-wrap: pretty;
  }
  .ah-tip.ah-bad {
    color: var(--ah-red);
  }
  .ah-board {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  /* ---- the map ---- */
  .ah-c-context,
  .ah-b-context {
    --c: var(--ah-blue);
  }
  .ah-c-action,
  .ah-b-action {
    --c: var(--ah-green);
  }
  .ah-c-guard,
  .ah-b-guard {
    --c: var(--ah-red);
  }
  .ah-c-memory,
  .ah-b-memory {
    --c: var(--ah-amber);
  }
  .ah-c-verify,
  .ah-b-verify {
    --c: var(--ah-g3);
  }
  .ah-c-control,
  .ah-b-control {
    --c: var(--ah-accent);
  }
  .ah-map {
    position: relative;
    display: grid;
    grid-template-columns: 1fr minmax(96px, 0.7fr) 1fr;
    grid-template-areas:
      "control context guard"
      "memory model action"
      ". verify .";
    flex: 1;
    gap: 34px 26px;
    align-items: center;
    align-content: space-evenly;
    margin: 8px 0 0;
    padding: 18px 12px;
    border: 1.5px dashed var(--ah-edge);
    border-radius: 20px;
  }
  .ah-map::before {
    content: "harness";
    position: absolute;
    top: -9px;
    left: 16px;
    padding: 0 8px;
    background: var(--ah-bg);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ah-mute);
  }
  .ah-wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  .ah-wire {
    fill: none;
    stroke: var(--c, var(--ah-mute));
    stroke-width: 2.5;
    stroke-linecap: round;
    opacity: 0.6;
  }
  .ah-port {
    fill: var(--ah-bg);
    stroke: var(--c, var(--ah-mute));
    stroke-width: 2.5;
  }
  .ah-idlewire .ah-wire {
    stroke: var(--ah-edge);
    stroke-dasharray: 3 7;
    opacity: 1;
  }
  .ah-idlewire .ah-port {
    stroke: var(--ah-edge);
  }
  /* a wire that is carrying something: dashes moving the way it goes */
  .ah-flowin .ah-wire,
  .ah-flowout .ah-wire {
    stroke-width: 3.5;
    stroke-dasharray: 2 9;
    opacity: 1;
    animation: ah-flow 500ms linear infinite;
  }
  .ah-flowout .ah-wire {
    animation-direction: reverse;
  }
  .ah-flowin .ah-port,
  .ah-flowout .ah-port {
    fill: var(--c);
  }
  @keyframes ah-flow {
    to {
      stroke-dashoffset: -22;
    }
  }
  .ah-w-context {
    --c: var(--ah-blue);
  }
  .ah-w-action {
    --c: var(--ah-green);
  }
  .ah-w-guard {
    --c: var(--ah-red);
  }
  .ah-w-memory {
    --c: var(--ah-amber);
  }
  .ah-w-verify {
    --c: var(--ah-g3);
  }
  .ah-w-control {
    --c: var(--ah-accent);
  }
  .ah-branch {
    position: relative;
    z-index: 1;
    justify-self: center;
    min-width: 64px;
    min-height: 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    padding: 16px 10px 10px;
    border-radius: 18px;
    border: 1.5px solid color-mix(in srgb, var(--c) 32%, var(--ah-bg));
    background: color-mix(in srgb, var(--c) 6%, var(--ah-bg));
  }
  .ah-b-control {
    grid-area: control;
  }
  .ah-b-context {
    grid-area: context;
  }
  .ah-b-guard {
    grid-area: guard;
  }
  .ah-b-memory {
    grid-area: memory;
  }
  .ah-b-action {
    grid-area: action;
  }
  .ah-b-verify {
    grid-area: verify;
  }
  .ah-branch.ah-fog {
    background: transparent;
    border-color: transparent;
  }
  .ah-branch.ah-fog::after {
    content: "?";
    margin: auto;
    font-size: 20px;
    font-weight: 800;
    color: color-mix(in srgb, var(--ah-edge) 70%, transparent);
  }
  .ah-branch.ah-appear {
    animation: ah-rise 320ms var(--ah-ease) both;
  }
  /* the section's name sits on the panel's top edge, like a tab */
  .ah-branch h3 {
    position: absolute;
    top: -9px;
    left: 50%;
    translate: -50% 0;
    margin: 0;
    padding: 0 8px;
    border-radius: 6px;
    background: var(--ah-bg);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 16px;
    white-space: nowrap;
    color: var(--c);
  }
  .ah-parts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }
  .ah-part {
    position: relative;
    width: 64px;
    padding: 7px 1px 5px !important;
    border-radius: 13px;
    display: flex !important;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    background: color-mix(in srgb, var(--c) 14%, var(--ah-tile)) !important;
    box-shadow: 0 3px 0 color-mix(in srgb, var(--c) 40%, var(--ah-edge));
    color: var(--c) !important;
    transition:
      transform 120ms var(--ah-ease),
      box-shadow 120ms var(--ah-ease),
      opacity 150ms;
  }
  .ah-part .ah-i {
    width: 20px;
    height: 20px;
  }
  .ah-part span {
    font-size: 9.5px;
    font-weight: 700;
    line-height: 1.1;
    color: var(--ah-ink);
    text-align: center;
  }
  .ah-part:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--c) 40%, var(--ah-edge));
  }
  .ah-part.ah-off {
    background: transparent !important;
    box-shadow: inset 0 0 0 1.5px var(--ah-edge);
    color: var(--ah-mute) !important;
  }
  .ah-part.ah-off span {
    color: var(--ah-mute);
  }
  .ah-part.ah-new {
    animation: ah-settle 260ms var(--ah-ease);
  }
  .ah-part.ah-ping,
  .ah-model.ah-ping {
    animation: ah-ping 360ms var(--ah-ease);
  }
  .ah-hinted {
    outline: 3px solid var(--ah-accent) !important;
    outline-offset: 2px !important;
  }
  .ah-model {
    grid-area: model;
    position: relative;
    z-index: 1;
    justify-self: center;
    width: 96px;
    height: 88px;
    border-radius: 20px;
    background: var(--ah-tile);
    box-shadow: 0 5px 0 var(--ah-edge);
    display: grid;
    place-items: end center;
    padding-bottom: 9px;
  }
  .ah-model b {
    font-size: 13px;
    font-weight: 800;
  }
  .ah-dot {
    position: absolute;
    left: -7px;
    top: -7px;
    z-index: 4;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--c, var(--ah-accent));
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 28%, transparent);
    opacity: 0;
    pointer-events: none;
    will-change: transform;
  }
  .ah-gem {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ah-ink);
    opacity: 0.55;
    flex: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .ah-part:hover {
      transform: translateY(-1px);
    }
    .ah-round:hover {
      color: var(--ah-ink) !important;
    }
  }
  .ah-shake {
    animation: ah-shake 380ms ease-in-out;
  }

  /* ---- the bot ---- */
  .ah-bot {
    position: absolute;
    left: 50%;
    top: 50px;
    width: 0;
    height: 0;
    z-index: 3;
    pointer-events: none;
  }
  .ah-body {
    position: absolute;
    left: -17px;
    top: -38px;
    width: 34px;
    height: 32px;
    border-radius: 13px 13px 11px 11px;
    background: var(--ah-accent);
    box-shadow: inset 0 -4px 0 var(--ah-accent-edge);
    display: grid;
    place-items: center;
    transform-origin: 50% 100%;
  }
  .ah-ant {
    position: absolute;
    left: -1px;
    top: -45px;
    width: 2px;
    height: 8px;
    background: var(--ah-accent-edge);
    transform-origin: 50% 100%;
  }
  .ah-ant::after {
    content: "";
    position: absolute;
    left: -2px;
    top: -5px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ah-task);
  }
  .ah-visor {
    width: 24px;
    height: 12px;
    margin-top: -3px;
    border-radius: 6px;
    background: #14161c;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
  }
  .ah-visor i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #fff;
    transition: transform 160ms var(--ah-ease);
  }
  .ah-bot[data-face="think"] .ah-visor i {
    transform: translateY(-2px);
  }
  .ah-bot[data-face="confused"] .ah-visor i:first-child {
    transform: scale(1.6);
  }
  .ah-bot[data-face="confused"] .ah-body {
    rotate: -8deg;
  }
  .ah-bot[data-face="alarm"] .ah-visor i {
    transform: scale(1.5);
    background: #ff8a7a;
  }
  .ah-bot[data-face="happy"] .ah-visor i {
    height: 2px;
    border-radius: 2px;
    transform: scaleX(1.5);
  }
  .ah-bot[data-face="happy"] .ah-body {
    animation: ah-bounce 600ms var(--ah-ease) 2;
  }
  .ah-bot[data-face="sad"] .ah-visor i,
  .ah-bot[data-face="dizzy"] .ah-visor i {
    height: 2px;
    transform: rotate(45deg) scaleX(1.6);
  }
  .ah-bot[data-face="dizzy"] .ah-body {
    animation: ah-wobble 900ms ease-in-out infinite;
  }
  .ah-bot[data-face="sad"] .ah-body {
    rotate: 6deg;
  }
  /* ---- the model chip ---- */
  .ah-modelchip {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 32px;
    border-radius: 16px;
    background: var(--ah-tile);
    box-shadow: 0 2px 0 var(--ah-edge);
    color: var(--ah-mute);
  }
  .ah .ah-chipmain {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 32px;
    padding: 0 4px 0 10px;
    border-radius: 16px 0 0 16px;
    font-size: 12.5px;
    font-weight: 700;
    color: inherit;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ah .ah-chipinfo {
    display: grid;
    place-items: center;
    width: 30px;
    height: 32px;
    border-radius: 0 16px 16px 0;
    color: var(--ah-mute);
  }
  .ah-chipinfo .ah-i {
    width: 16px;
    height: 16px;
  }
  .ah-pop {
    position: absolute;
    z-index: 30;
    top: calc(100% + 8px);
    right: 0;
    width: min(300px, calc(100vw - 24px));
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--ah-card);
    box-shadow:
      0 0 0 1.5px var(--ah-edge),
      0 10px 30px rgb(0 0 0 / 0.18);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ah-ink);
    white-space: normal;
  }
  .ah-pop a {
    color: var(--ah-accent);
    font-weight: 800;
    text-decoration: underline;
  }
  .ah-short {
    display: none;
  }
  .ah-chipmain i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ah-edge);
  }
  .ah-modelchip[data-state="real"] {
    color: var(--ah-ink);
  }
  .ah-modelchip[data-state="real"] i {
    background: var(--ah-green);
  }
  .ah-modelchip[data-state="loading"] i {
    background: var(--ah-amber);
    animation: ah-blink 1s ease-in-out infinite;
  }
  .ah-modelchip[data-state="failed"] i {
    background: var(--ah-red);
  }

  /* ---- the level tiles ---- */
  .ah-pips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
  }
  .ah .ah-pip {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    border: 1.5px dashed var(--ah-edge);
    background: transparent !important;
    color: var(--ah-mute) !important;
    font-size: 13px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    transition:
      background 200ms var(--ah-ease),
      transform 120ms var(--ah-ease);
  }
  .ah .ah-pip[data-state="open"] {
    border: 1.5px solid var(--c);
    background: color-mix(in srgb, var(--c) 16%, var(--ah-tile)) !important;
    color: var(--ah-ink) !important;
  }
  .ah .ah-pip[data-state="done"] {
    border: 1.5px solid var(--c);
    background: var(--c) !important;
    color: #fff !important;
    box-shadow: 0 2px 0 color-mix(in srgb, var(--c) 60%, #000);
  }
  .ah .ah-pip[aria-current="true"] {
    outline: 2px solid var(--ah-ink);
    outline-offset: 2px;
  }
  .ah-pip:disabled {
    cursor: default;
    opacity: 0.7;
  }
  .ah-pip:not(:disabled):active {
    transform: translateY(2px);
  }
  @media (max-width: 520px) {
    .ah-pips {
      gap: 5px;
    }
    .ah .ah-pip {
      width: 28px;
      height: 28px;
      border-radius: 8px;
      font-size: 12px;
    }
  }

  /* ---- the level-cleared card ---- */
  .ah-kicker {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ah-mute);
  }
  .ah-cleared .ah-sheettitle {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 4px 0 12px;
    font-size: 28px;
    color: var(--c);
  }
  .ah-cleared .ah-sheettitle span {
    color: var(--ah-ink);
  }
  .ah-cleared .ah-sheettitle .ah-i {
    width: 30px;
    height: 30px;
  }
  .ah-cleared .ah-evals {
    margin-bottom: 12px;
  }
  .ah .ah-added {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    margin: 10px 0 0;
    padding: 10px 12px;
    border-radius: 12px;
    background: var(--ah-tile) !important;
    color: var(--ah-ink) !important;
    font-weight: 700;
    text-align: left;
  }
  .ah-added span {
    flex: 1;
  }
  .ah-added .ah-i:last-child {
    color: var(--ah-mute);
  }
  .ah-added .ah-i {
    width: 18px;
    height: 18px;
  }
  .ah-cardbtns {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 8px;
    margin-top: 16px;
  }
  .ah-fly {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 60;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--c);
    color: #fff;
    opacity: 0;
    pointer-events: none;
  }
  .ah-fly .ah-i {
    width: 20px;
    height: 20px;
  }
  .ah-round.ah-bump {
    z-index: 50;
    animation: ah-bump 520ms var(--ah-ease);
  }
