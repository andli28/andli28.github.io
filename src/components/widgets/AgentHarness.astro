---
/**
 * Harness: a plan-then-run puzzle about what the code around a model does.
 * Meant for a Lab entry with `fullscreen: true`. Progress lives in
 * localStorage. The board is built by harness/ui.js.
 *
 *   import AgentHarness from "@/components/widgets/AgentHarness.astro";
 *   <AgentHarness />
 */
---

<div class="ah">
  <noscript>This game needs JavaScript.</noscript>
</div>

<script>
  import { mountHarness } from "./harness/ui.js";
  const mountAll = () =>
    document.querySelectorAll<HTMLElement>(".ah").forEach(mountHarness);
  document.addEventListener("astro:page-load", mountAll);
  mountAll();
</script>

<style is:global>
  .ah {
    --ah-bg: #efeeea;
    --ah-card: #f8f7f4;
    --ah-ink: #24262b;
    --ah-mute: #868990;
    --ah-tile: #ffffff;
    --ah-edge: #d3d1c9;
    --ah-line: #e2e0d9;
    --ah-accent: #4b5bdc;
    --ah-accent-edge: #3441a8;
    --ah-on-accent: #ffffff;
    --ah-red: #df4f3c;
    --ah-amber: #e3a21c;
    --ah-green: #2c9a6a;
    --ah-blue: #3486cf;
    --ah-task: #f4c430;
    --ah-g0: #ef476f;
    --ah-g1: #06a77d;
    --ah-g2: #118ab2;
    --ah-g3: #8f5fd7;
    --ah-g4: #f08c00;
    --ah-ease: cubic-bezier(0.23, 1, 0.32, 1);

    position: relative;
    min-height: 100svh;
    background: var(--ah-bg);
    color: var(--ah-ink);
    font-family:
      ui-rounded,
      "SF Pro Rounded",
      "Nunito",
      system-ui,
      -apple-system,
      "Segoe UI",
      sans-serif;
    font-size: 15px;
    line-height: 1.4;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
    overflow-x: clip;
  }
  [data-theme="dark"] .ah {
    --ah-bg: #15171c;
    --ah-card: #1b1e25;
    --ah-ink: #eceef2;
    --ah-mute: #8b909b;
    --ah-tile: #272b35;
    --ah-edge: #0d0f13;
    --ah-line: #2c313c;
    --ah-accent: #6c7bff;
    --ah-accent-edge: #4250c9;
    --ah-task: #d9aa1e;
  }
  .lab-full:has(.ah) .lab-back {
    color: var(--ah-mute, #868990);
    position: absolute;
  }
  .lab-full:has(.ah) .lab-back:hover {
    color: #4b5bdc;
  }

  .ah button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .ah button:disabled {
    cursor: default;
  }
  .ah :focus-visible {
    outline: 2px solid var(--ah-accent);
    outline-offset: 2px;
  }
  .ah [hidden] {
    display: none !important;
  }
  .ah .ah-i {
    width: 1.35em;
    height: 1.35em;
    flex: none;
  }

  .ah-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: 52px 16px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* ---- level chips ---- */
  .ah-levels {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    padding: 4px 2px 8px;
    scrollbar-width: none;
  }
  .ah-levels::-webkit-scrollbar {
    display: none;
  }
  .ah-lv {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 9px;
    border: 1.5px dashed var(--ah-edge) !important;
    color: var(--ah-mute) !important;
    font-size: 12px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    transition:
      transform 120ms var(--ah-ease),
      background-color 150ms;
  }
  .ah-lv.ah-gap {
    margin-left: 8px;
  }
  .ah-lv:disabled {
    opacity: 0.45;
  }
  .ah-lv[data-stars] {
    border-style: solid !important;
    background: var(--ah-tile);
    color: var(--ah-ink) !important;
  }
  .ah-lv[data-stars="3"] {
    border-color: var(--ah-task) !important;
  }
  .ah-lv[aria-current="true"] {
    background: var(--ah-accent);
    border-color: var(--ah-accent-edge) !important;
    border-style: solid !important;
    color: var(--ah-on-accent) !important;
    box-shadow: 0 3px 0 var(--ah-accent-edge);
    transform: translateY(-1px);
  }
  .ah-lv:not(:disabled):active {
    transform: scale(0.94);
  }

  /* ---- header ---- */
  .ah-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ah-name {
    margin: 0;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    flex: 1;
    min-width: 0;
    text-wrap: balance;
  }
  .ah-name small {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ah-mute);
    margin-bottom: 3px;
  }
  .ah-stars {
    display: flex;
    gap: 2px;
    color: var(--ah-edge);
  }
  .ah-stars .ah-on {
    color: var(--ah-task);
  }
  .ah-stars .ah-i {
    width: 20px;
    height: 20px;
    stroke-width: 0;
  }
  .ah-stars.ah-big .ah-i {
    width: 40px;
    height: 40px;
  }
  .ah-stars .ah-pop.ah-on {
    animation: ah-pop 420ms var(--ah-ease) both;
    animation-delay: var(--d, 0ms);
  }
  .ah-tools {
    display: flex;
    gap: 6px;
  }
  .ah-round {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--ah-tile) !important;
    box-shadow: 0 2px 0 var(--ah-edge);
    color: var(--ah-mute) !important;
    transition: transform 120ms var(--ah-ease);
  }
  .ah-round:active {
    transform: translateY(2px);
    box-shadow: none;
  }
  .ah-round[data-count]:not([data-count=""])::after {
    content: attr(data-count);
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 8px;
    background: var(--ah-accent);
    color: var(--ah-on-accent);
    font-size: 10px;
    font-weight: 700;
    line-height: 16px;
  }

  /* ---- board ---- */
  .ah-board {
    position: relative;
    background: var(--ah-card);
    border-radius: 22px;
    padding: 16px 16px 14px;
    box-shadow: 0 1px 0 var(--ah-line);
  }
  .ah-tip {
    margin: 0;
    min-height: 2.8em;
    padding-right: 64px;
    color: var(--ah-mute);
    font-weight: 600;
    text-wrap: pretty;
  }
  .ah-tip.ah-bad {
    color: var(--ah-red);
  }
  .ah-hearts {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    gap: 2px;
    color: var(--ah-red);
  }
  .ah-hearts .ah-i {
    width: 20px;
    height: 20px;
    stroke-width: 0;
    transition:
      transform 300ms var(--ah-ease),
      opacity 300ms;
  }
  .ah-hearts .ah-gone {
    opacity: 0.18;
    transform: scale(0.7);
  }

  .ah-track {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 8px;
    margin-top: 4px;
  }
  .ah-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding-top: 46px;
    width: 56px;
  }
  .ah-tile {
    position: relative;
    width: 56px;
    height: 56px;
    border-radius: 15px;
    background: var(--ah-tile) !important;
    box-shadow: 0 4px 0 var(--ah-edge);
    display: grid;
    place-items: center;
    color: var(--ah-ink) !important;
    transition:
      transform 140ms var(--ah-ease),
      box-shadow 140ms var(--ah-ease);
  }
  .ah-tile > .ah-i {
    width: 24px;
    height: 24px;
    margin-top: -6px;
  }
  .ah-start {
    background: var(--ah-task) !important;
    box-shadow: 0 4px 0 color-mix(in srgb, var(--ah-task) 70%, #000);
    color: #3a2f00 !important;
  }
  .ah-flag {
    background: var(--ah-ink) !important;
    box-shadow: 0 4px 0 color-mix(in srgb, var(--ah-ink) 60%, #000);
    color: var(--ah-bg) !important;
  }
  .ah-start > .ah-i,
  .ah-flag > .ah-i,
  .ah-trap > .ah-i {
    margin-top: 0;
  }
  .ah-trap {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: color-mix(
      in srgb,
      var(--ah-red) 14%,
      var(--ah-tile)
    ) !important;
    box-shadow: 0 3px 0 color-mix(in srgb, var(--ah-red) 45%, var(--ah-edge));
    color: var(--ah-red) !important;
  }
  .ah-trapwrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-top: 2px;
  }
  .ah-trapwrap::before {
    content: "";
    width: 2px;
    height: 10px;
    border-left: 2px dotted var(--ah-red);
  }
  .ah-danger {
    background: color-mix(
      in srgb,
      var(--ah-red) 16%,
      var(--ah-tile)
    ) !important;
    box-shadow: 0 4px 0 color-mix(in srgb, var(--ah-red) 50%, var(--ah-edge));
    color: var(--ah-red) !important;
  }
  .ah-amber {
    box-shadow:
      inset 0 0 0 2.5px var(--ah-amber),
      0 4px 0 color-mix(in srgb, var(--ah-amber) 60%, var(--ah-edge));
  }
  .ah-dull {
    color: var(--ah-mute) !important;
  }
  .ah-spiky {
    box-shadow:
      inset 0 0 0 2.5px var(--ah-g3),
      0 4px 0 color-mix(in srgb, var(--ah-g3) 60%, var(--ah-edge));
  }
  .ah-skipped {
    opacity: 0.4;
  }
  .ah-needs {
    position: absolute;
    top: 5px;
    left: 6px;
    display: flex;
    gap: 2px;
  }
  .ah-marks {
    position: absolute;
    top: 3px;
    right: 6px;
    font-size: 11px;
    font-weight: 800;
    color: var(--ah-red);
  }
  .ah-dull .ah-marks {
    color: var(--ah-mute);
  }
  .ah-pips {
    position: absolute;
    bottom: 6px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2px;
  }
  .ah-pip {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--ah-edge);
  }
  [data-theme="dark"] .ah-pip {
    background: #4a505e;
  }
  .ah-gem {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ah-g0);
    flex: none;
  }
  .ah-g1 {
    background: var(--ah-g1);
  }
  .ah-g2 {
    background: var(--ah-g2);
  }
  .ah-g3 {
    background: var(--ah-g3);
  }
  .ah-g4 {
    background: var(--ah-g4);
  }
  .ah-gem.ah-exact {
    border-radius: 1.5px;
    transform: rotate(45deg) scale(0.9);
  }
  .ah-gem.ah-need {
    width: 7px;
    height: 7px;
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--ah-g0);
  }
  .ah-need.ah-g1 {
    box-shadow: inset 0 0 0 2px var(--ah-g1);
  }
  .ah-need.ah-g2 {
    box-shadow: inset 0 0 0 2px var(--ah-g2);
  }
  .ah-need.ah-g3 {
    box-shadow: inset 0 0 0 2px var(--ah-g3);
  }
  .ah-need.ah-g4 {
    box-shadow: inset 0 0 0 2px var(--ah-g4);
  }
  .ah-gem.ah-float {
    position: absolute;
    right: 7px;
    bottom: 14px;
  }

  .ah-slot {
    min-height: 30px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3px;
  }

  /* sockets light up while a chip is in hand */
  .ah-arming [data-sock]:not(.ah-can) {
    opacity: 0.45;
  }
  .ah-can.ah-tile,
  .ah-hinted.ah-tile,
  .ah-pick.ah-tile {
    outline: 2.5px solid var(--ah-accent);
    outline-offset: 2px;
  }
  .ah-hinted {
    outline: 3px solid var(--ah-accent) !important;
    outline-offset: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    .ah-can:hover {
      transform: translateY(-2px);
    }
    .ah-round:hover {
      color: var(--ah-ink) !important;
    }
  }
  .ah-shake {
    animation: ah-shake 380ms ease-in-out;
  }

  /* ---- the bot ---- */
  .ah-bot {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    z-index: 3;
    pointer-events: none;
    transition: transform 300ms cubic-bezier(0.3, 0.7, 0.3, 1);
    will-change: transform;
  }
  .ah-bot.ah-snap {
    transition: none;
  }
  .ah-body {
    position: absolute;
    left: -17px;
    top: -38px;
    width: 34px;
    height: 32px;
    border-radius: 13px 13px 11px 11px;
    background: var(--ah-accent);
    box-shadow: inset 0 -4px 0 var(--ah-accent-edge);
    display: grid;
    place-items: center;
    transform-origin: 50% 100%;
  }
  .ah-ant {
    position: absolute;
    left: -1px;
    top: -45px;
    width: 2px;
    height: 8px;
    background: var(--ah-accent-edge);
    transform-origin: 50% 100%;
  }
  .ah-ant::after {
    content: "";
    position: absolute;
    left: -2px;
    top: -5px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ah-task);
  }
  .ah-hop .ah-body,
  .ah-hop .ah-ant {
    animation: ah-hop 300ms cubic-bezier(0.3, 0.7, 0.3, 1);
  }
  .ah-visor {
    width: 24px;
    height: 12px;
    margin-top: -3px;
    border-radius: 6px;
    background: #14161c;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
  }
  .ah-visor i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #fff;
    transition: transform 160ms var(--ah-ease);
  }
  .ah-bot[data-face="think"] .ah-visor i {
    transform: translateY(-2px);
  }
  .ah-bot[data-face="confused"] .ah-visor i:first-child {
    transform: scale(1.6);
  }
  .ah-bot[data-face="confused"] .ah-body {
    rotate: -8deg;
  }
  .ah-bot[data-face="alarm"] .ah-visor i {
    transform: scale(1.5);
    background: #ff8a7a;
  }
  .ah-bot[data-face="happy"] .ah-visor i {
    height: 2px;
    border-radius: 2px;
    transform: scaleX(1.5);
  }
  .ah-bot[data-face="happy"] .ah-body {
    animation: ah-bounce 600ms var(--ah-ease) 2;
  }
  .ah-bot[data-face="sad"] .ah-visor i,
  .ah-bot[data-face="dizzy"] .ah-visor i {
    height: 2px;
    transform: rotate(45deg) scaleX(1.6);
  }
  .ah-bot[data-face="dizzy"] .ah-body {
    animation: ah-wobble 900ms ease-in-out infinite;
  }
  .ah-bot[data-face="sad"] .ah-body {
    rotate: 6deg;
  }
  .ah-bubble {
    position: absolute;
    left: 0;
    top: -72px;
    transform: translateX(-50%) translateY(4px);
    white-space: nowrap;
    padding: 4px 10px;
    border-radius: 10px;
    background: var(--ah-ink);
    color: var(--ah-bg);
    font-size: 13px;
    font-weight: 700;
    opacity: 0;
    transition:
      opacity 160ms var(--ah-ease),
      transform 160ms var(--ah-ease);
  }
  .ah-bubble.ah-show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* ---- harness rack ---- */
  .ah-rack {
    display: flex !important;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    width: 100%;
    min-height: 54px;
    margin-top: 12px;
    padding: 7px 8px !important;
    border-radius: 16px;
    border: 1.5px dashed var(--ah-edge) !important;
    text-align: left;
    cursor: default !important;
  }
  .ah-rack.ah-can {
    border-color: var(--ah-accent) !important;
    cursor: pointer !important;
  }
  .ah-racklabel {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ah-mute);
    padding: 0 4px;
  }

  /* ---- chips ---- */
  .ah-chip {
    --c: var(--ah-ink);
    position: relative;
    display: inline-flex !important;
    align-items: center;
    gap: 5px;
    height: 38px;
    min-width: 38px;
    padding: 0 9px !important;
    border-radius: 12px;
    background: color-mix(in srgb, var(--c) 12%, var(--ah-tile)) !important;
    box-shadow: 0 3px 0 color-mix(in srgb, var(--c) 35%, var(--ah-edge));
    color: var(--c) !important;
    font-weight: 700;
    font-size: 13px;
    transition:
      transform 120ms var(--ah-ease),
      box-shadow 120ms var(--ah-ease),
      opacity 150ms;
    touch-action: none;
  }
  .ah-chip.ah-tool {
    --c: var(--ah-mute);
    color: var(--ah-ink) !important;
  }
  .ah-chip.ah-safe {
    --c: var(--ah-red);
  }
  .ah-chip.ah-ctx {
    --c: var(--ah-blue);
  }
  .ah-chip.ah-scale {
    --c: var(--ah-green);
  }
  .ah-chip.ah-core {
    --c: var(--ah-accent);
  }
  .ah-chip em {
    font-style: normal;
    font-size: 11px;
  }
  .ah-chip:not(:disabled):active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--c) 35%, var(--ah-edge));
  }
  .ah-chip:disabled {
    opacity: 0.35;
  }
  .ah-chip.ah-lock {
    box-shadow: none;
    background: transparent !important;
    opacity: 0.75;
    cursor: default;
    touch-action: auto;
  }
  .ah-rack .ah-chip.ah-lock {
    padding: 0 4px !important;
    min-width: 28px;
  }
  .ah-chip.ah-mini {
    height: 26px;
    min-width: 26px;
    padding: 0 4px !important;
    border-radius: 8px;
    font-size: 11px;
    gap: 2px;
    box-shadow: 0 2px 0 color-mix(in srgb, var(--c) 35%, var(--ah-edge));
  }
  .ah-chip.ah-mini em {
    font-size: 9px;
    letter-spacing: -0.02em;
  }
  .ah-chip.ah-mini .ah-i {
    width: 15px;
    height: 15px;
  }
  .ah-chip.ah-lifted {
    opacity: 0.3;
    transform: none;
    box-shadow: none;
  }
  .ah-chip.ah-ghost {
    position: fixed;
    left: 0;
    top: 0;
    margin: 0;
    z-index: 50;
    pointer-events: none;
    opacity: 1;
    box-shadow: 0 10px 22px rgb(0 0 0 / 0.2);
    transition: none;
    will-change: transform;
  }
  .ah-chip.ah-ghost.ah-return {
    transition:
      transform 180ms var(--ah-ease),
      opacity 180ms var(--ah-ease);
  }
  .ah-chip.ah-settle {
    animation: ah-settle 160ms var(--ah-ease);
  }
  .ah-chip.ah-armed {
    outline: 2.5px solid var(--ah-accent);
    outline-offset: 2px;
    transform: translateY(-2px);
  }
  .ah-chip.ah-dropin {
    animation: ah-dropin 240ms var(--ah-ease) both;
  }

  .ah-tray {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }
  .ah-traychip em {
    display: none;
  }
  .ah-traychip u {
    text-decoration: none;
    font-size: 11px;
    min-width: 16px;
    height: 16px;
    line-height: 16px;
    border-radius: 8px;
    background: var(--c);
    color: var(--ah-tile);
    text-align: center;
  }
  .ah-slots {
    margin-left: auto;
    font-size: 12px;
    font-weight: 700;
    color: var(--ah-mute);
    font-variant-numeric: tabular-nums;
  }

  /* ---- window ---- */
  .ah-winhead {
    display: flex;
    justify-content: space-between;
    margin-top: 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ah-mute);
    font-variant-numeric: tabular-nums;
  }
  .ah-winhead .ah-bad {
    color: var(--ah-red);
  }
  .ah-win {
    position: relative;
    height: 40px;
    margin-top: 5px;
  }
  .ah-cells {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    gap: 2px;
  }
  .ah-cell {
    border-radius: 7px;
    background: color-mix(in srgb, var(--ah-edge) 38%, transparent) !important;
    display: grid !important;
