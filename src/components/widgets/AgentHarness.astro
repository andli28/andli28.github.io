---
/**
 * Harness: build the harness around a model, one job and one part at a time.
 * Meant for a Lab entry with `fullscreen: true`. Progress lives in
 * localStorage. The board is built by harness/ui.js.
 *
 *   import AgentHarness from "@/components/widgets/AgentHarness.astro";
 *   <AgentHarness />
 */
---

<div class="ah">
  <noscript>This game needs JavaScript.</noscript>
</div>

<script>
  import { mountHarness } from "./harness/ui.js";
  const mountAll = () =>
    document.querySelectorAll<HTMLElement>(".ah").forEach(mountHarness);
  document.addEventListener("astro:page-load", mountAll);
  mountAll();
</script>

<style is:global>
  .ah {
    --ah-bg: #efeeea;
    --ah-card: #f8f7f4;
    --ah-ink: #24262b;
    --ah-mute: #868990;
    --ah-tile: #ffffff;
    --ah-edge: #d3d1c9;
    --ah-line: #e2e0d9;
    --ah-accent: #4b5bdc;
    --ah-accent-edge: #3441a8;
    --ah-on-accent: #ffffff;
    --ah-red: #df4f3c;
    --ah-amber: #e3a21c;
    --ah-green: #2c9a6a;
    --ah-blue: #3486cf;
    --ah-task: #f4c430;
    --ah-g0: #ef476f;
    --ah-g1: #06a77d;
    --ah-g2: #118ab2;
    --ah-g3: #8f5fd7;
    --ah-g4: #f08c00;
    --ah-ease: cubic-bezier(0.23, 1, 0.32, 1);

    position: relative;
    min-height: 100svh;
    background: var(--ah-bg);
    color: var(--ah-ink);
    font-family:
      ui-rounded,
      "SF Pro Rounded",
      "Nunito",
      system-ui,
      -apple-system,
      "Segoe UI",
      sans-serif;
    font-size: 15px;
    line-height: 1.4;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
    overflow-x: clip;
  }
  [data-theme="dark"] .ah {
    --ah-bg: #15171c;
    --ah-card: #1b1e25;
    --ah-ink: #eceef2;
    --ah-mute: #8b909b;
    --ah-tile: #272b35;
    --ah-edge: #0d0f13;
    --ah-line: #2c313c;
    --ah-accent: #6c7bff;
    --ah-accent-edge: #4250c9;
    --ah-task: #d9aa1e;
  }
  .lab-full:has(.ah) .lab-back {
    color: var(--ah-mute, #868990);
    position: absolute;
  }
  .lab-full:has(.ah) .lab-back:hover {
    color: #4b5bdc;
  }

  .ah button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .ah button:disabled {
    cursor: default;
  }
  .ah :focus-visible {
    outline: 2px solid var(--ah-accent);
    outline-offset: 2px;
  }
  .ah [hidden] {
    display: none !important;
  }
  .ah .ah-i {
    width: 1.35em;
    height: 1.35em;
    flex: none;
  }

  .ah-wrap {
    box-sizing: border-box;
    min-height: 100svh;
    padding: 10px 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* ---- header ---- */
  .ah-head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-left: 62px;
  }
  .ah-name {
    margin: 0;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .ah-pager {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-right: auto;
  }
  .ah-count {
    min-width: 4.2em;
    text-align: center;
    font-size: 13px;
    font-weight: 800;
    color: var(--ah-mute);
    font-variant-numeric: tabular-nums;
  }
  .ah-round:disabled {
    opacity: 0.35;
  }
  .ah-stars {
    display: flex;
    gap: 2px;
    color: var(--ah-edge);
  }
  .ah-stars .ah-on {
    color: var(--ah-task);
  }
  .ah-stars .ah-i {
    width: 20px;
    height: 20px;
    stroke-width: 0;
  }
  .ah-stars.ah-big .ah-i {
    width: 40px;
    height: 40px;
  }
  .ah-stars .ah-pop.ah-on {
    animation: ah-pop 420ms var(--ah-ease) both;
    animation-delay: var(--d, 0ms);
  }
  .ah-tools {
    display: flex;
    gap: 6px;
  }
  .ah-round {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--ah-tile) !important;
    box-shadow: 0 2px 0 var(--ah-edge);
    color: var(--ah-mute) !important;
    transition: transform 120ms var(--ah-ease);
  }
  .ah-round:active {
    transform: translateY(2px);
    box-shadow: none;
  }
  .ah-round[data-count]:not([data-count=""])::after {
    content: attr(data-count);
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 8px;
    background: var(--ah-accent);
    color: var(--ah-on-accent);
    font-size: 10px;
    font-weight: 700;
    line-height: 16px;
  }

  /* ---- board ---- */
  .ah-board {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .ah-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: 8px;
    text-align: center;
  }
  .ah-ask {
    grid-column: 2;
    margin: 0;
    max-width: 34ch;
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.25;
    min-height: 2.5em;
    display: grid;
    align-items: end;
    text-wrap: balance;
  }
  .ah-tip {
    grid-column: 1 / -1;
    margin: 4px auto 0;
    min-height: 1.4em;
    max-width: 52ch;
    color: var(--ah-mute);
    font-weight: 600;
    text-wrap: pretty;
  }
  .ah-tip.ah-bad {
    color: var(--ah-red);
  }
  .ah-hearts {
    grid-column: 3;
    justify-self: start;
    display: flex;
    gap: 2px;
    color: var(--ah-red);
  }
  .ah-hearts .ah-i {
    width: 20px;
    height: 20px;
    stroke-width: 0;
    transition:
      transform 300ms var(--ah-ease),
      opacity 300ms;
  }
  .ah-hearts .ah-gone {
    opacity: 0.18;
    transform: scale(0.7);
  }

  /* ---- the map ---- */
  .ah-c-context,
  .ah-b-context {
    --c: var(--ah-blue);
  }
  .ah-c-action,
  .ah-b-action {
    --c: var(--ah-green);
  }
  .ah-c-guard,
  .ah-b-guard {
    --c: var(--ah-red);
  }
  .ah-c-persist,
  .ah-b-persist {
    --c: var(--ah-amber);
  }
  .ah-c-verify,
  .ah-b-verify {
    --c: var(--ah-g3);
  }
  .ah-c-control,
  .ah-b-control {
    --c: var(--ah-accent);
  }
  .ah-map {
    position: relative;
    display: grid;
    grid-template-columns: 1fr minmax(96px, 0.7fr) 1fr;
    grid-template-areas:
      "control context guard"
      "persist model action"
      ". verify .";
    flex: 1;
    gap: 34px 26px;
    align-items: center;
    align-content: space-evenly;
    margin: 18px 0 0;
    padding: 18px 12px;
    border: 1.5px dashed var(--ah-edge);
    border-radius: 20px;
  }
  .ah-map::before {
    content: "harness";
    position: absolute;
    top: -9px;
    left: 16px;
    padding: 0 8px;
    background: var(--ah-bg);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ah-mute);
  }
  .ah-wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  .ah-wire {
    stroke: var(--c, var(--ah-mute));
    stroke-width: 2.5;
    stroke-linecap: round;
    opacity: 0.55;
  }
  .ah-w-context {
    --c: var(--ah-blue);
  }
  .ah-w-action {
    --c: var(--ah-green);
  }
  .ah-w-guard {
    --c: var(--ah-red);
  }
  .ah-w-persist {
    --c: var(--ah-amber);
  }
  .ah-w-verify {
    --c: var(--ah-g3);
  }
  .ah-w-control {
    --c: var(--ah-accent);
  }
  .ah-branch {
    position: relative;
    z-index: 1;
    justify-self: center;
    min-width: 64px;
    min-height: 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    padding: 6px;
    border-radius: 14px;
    background: var(--ah-bg);
  }
  .ah-b-control {
    grid-area: control;
  }
  .ah-b-context {
    grid-area: context;
  }
  .ah-b-guard {
    grid-area: guard;
  }
  .ah-b-persist {
    grid-area: persist;
  }
  .ah-b-action {
    grid-area: action;
  }
  .ah-b-verify {
    grid-area: verify;
  }
  .ah-branch.ah-fog {
    background: transparent;
  }
  .ah-branch.ah-fog::after {
    content: "?";
    margin: auto;
    font-size: 20px;
    font-weight: 800;
    color: color-mix(in srgb, var(--ah-edge) 70%, transparent);
  }
  .ah-branch.ah-appear {
    animation: ah-rise 320ms var(--ah-ease) both;
  }
  .ah-branch h3 {
    margin: 0;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--c);
  }
  .ah-parts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }
  .ah-part {
    position: relative;
    width: 64px;
    padding: 7px 1px 5px !important;
    border-radius: 13px;
    display: flex !important;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    background: color-mix(in srgb, var(--c) 14%, var(--ah-tile)) !important;
    box-shadow: 0 3px 0 color-mix(in srgb, var(--c) 40%, var(--ah-edge));
    color: var(--c) !important;
    transition:
      transform 120ms var(--ah-ease),
      box-shadow 120ms var(--ah-ease),
      opacity 150ms;
  }
  .ah-part .ah-i {
    width: 20px;
    height: 20px;
  }
  .ah-part span {
    font-size: 9.5px;
    font-weight: 700;
    line-height: 1.1;
    color: var(--ah-ink);
    text-align: center;
  }
  .ah-part:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--c) 40%, var(--ah-edge));
  }
  .ah-part.ah-off {
    background: transparent !important;
    box-shadow: inset 0 0 0 1.5px var(--ah-edge);
    color: var(--ah-mute) !important;
  }
  .ah-part.ah-off span {
    color: var(--ah-mute);
  }
  .ah-part.ah-new {
    animation: ah-settle 260ms var(--ah-ease);
  }
  .ah-part.ah-ping,
  .ah-model.ah-ping {
    animation: ah-ping 360ms var(--ah-ease);
  }
  .ah-hinted {
    outline: 3px solid var(--ah-accent) !important;
    outline-offset: 2px !important;
  }
  .ah-model {
    grid-area: model;
    position: relative;
    z-index: 1;
    justify-self: center;
    width: 96px;
    height: 88px;
    border-radius: 20px;
    background: var(--ah-tile);
    box-shadow: 0 5px 0 var(--ah-edge);
    display: grid;
    place-items: end center;
    padding-bottom: 9px;
  }
  .ah-model b {
    font-size: 13px;
    font-weight: 800;
  }
  .ah-dot {
    position: absolute;
    left: -6px;
    top: -6px;
    z-index: 4;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--c, var(--ah-accent));
    opacity: 0;
    pointer-events: none;
    will-change: transform;
  }
  .ah-gem {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ah-ink);
    opacity: 0.55;
    flex: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .ah-part:hover {
      transform: translateY(-1px);
    }
    .ah-round:hover {
      color: var(--ah-ink) !important;
    }
  }
  .ah-shake {
    animation: ah-shake 380ms ease-in-out;
  }

  /* ---- the bot ---- */
  .ah-bot {
    position: absolute;
    left: 50%;
    top: 50px;
    width: 0;
    height: 0;
    z-index: 3;
    pointer-events: none;
  }
  .ah-body {
    position: absolute;
    left: -17px;
    top: -38px;
    width: 34px;
    height: 32px;
    border-radius: 13px 13px 11px 11px;
    background: var(--ah-accent);
    box-shadow: inset 0 -4px 0 var(--ah-accent-edge);
    display: grid;
    place-items: center;
    transform-origin: 50% 100%;
  }
  .ah-ant {
    position: absolute;
    left: -1px;
    top: -45px;
    width: 2px;
    height: 8px;
    background: var(--ah-accent-edge);
    transform-origin: 50% 100%;
  }
  .ah-ant::after {
    content: "";
    position: absolute;
    left: -2px;
    top: -5px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ah-task);
  }
  .ah-visor {
    width: 24px;
    height: 12px;
    margin-top: -3px;
    border-radius: 6px;
    background: #14161c;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
  }
  .ah-visor i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #fff;
    transition: transform 160ms var(--ah-ease);
  }
  .ah-bot[data-face="think"] .ah-visor i {
    transform: translateY(-2px);
  }
  .ah-bot[data-face="confused"] .ah-visor i:first-child {
    transform: scale(1.6);
  }
  .ah-bot[data-face="confused"] .ah-body {
    rotate: -8deg;
  }
  .ah-bot[data-face="alarm"] .ah-visor i {
    transform: scale(1.5);
    background: #ff8a7a;
  }
  .ah-bot[data-face="happy"] .ah-visor i {
    height: 2px;
    border-radius: 2px;
    transform: scaleX(1.5);
  }
  .ah-bot[data-face="happy"] .ah-body {
    animation: ah-bounce 600ms var(--ah-ease) 2;
  }
  .ah-bot[data-face="sad"] .ah-visor i,
  .ah-bot[data-face="dizzy"] .ah-visor i {
    height: 2px;
    transform: rotate(45deg) scaleX(1.6);
  }
  .ah-bot[data-face="dizzy"] .ah-body {
    animation: ah-wobble 900ms ease-in-out infinite;
  }
  .ah-bot[data-face="sad"] .ah-body {
    rotate: 6deg;
  }
  .ah-bubble {
    position: absolute;
    left: 0;
    top: -72px;
    transform: translateX(-50%) translateY(4px);
    white-space: nowrap;
    padding: 4px 10px;
    border-radius: 10px;
    background: var(--ah-ink);
    color: var(--ah-bg);
    font-size: 13px;
    font-weight: 700;
    opacity: 0;
    transition:
      opacity 160ms var(--ah-ease),
      transform 160ms var(--ah-ease);
  }
  .ah-bubble.ah-show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* ---- chips ---- */
  .ah-chip {
    --c: var(--ah-ink);
    position: relative;
    display: inline-flex !important;
    align-items: center;
    gap: 5px;
    height: 38px;
    min-width: 38px;
    padding: 0 9px !important;
    border-radius: 12px;
    background: color-mix(in srgb, var(--c) 12%, var(--ah-tile)) !important;
    box-shadow: 0 3px 0 color-mix(in srgb, var(--c) 35%, var(--ah-edge));
    color: var(--c) !important;
    font-weight: 700;
    font-size: 13px;
    transition:
      transform 120ms var(--ah-ease),
      box-shadow 120ms var(--ah-ease),
      opacity 150ms;
    touch-action: none;
  }
  .ah-chip.ah-tool {
    --c: var(--ah-mute);
    color: var(--ah-ink) !important;
  }
  .ah-chip.ah-safe {
    --c: var(--ah-red);
  }
  .ah-chip.ah-ctx {
    --c: var(--ah-blue);
  }
  .ah-chip.ah-scale {
    --c: var(--ah-green);
  }
  .ah-chip.ah-core {
    --c: var(--ah-accent);
  }
  .ah-chip em {
    font-style: normal;
    font-size: 11px;
  }
  .ah-chip:not(:disabled):active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--c) 35%, var(--ah-edge));
  }
  .ah-chip:disabled {
    opacity: 0.35;
  }
  .ah-chip.ah-lock {
    box-shadow: none;
    background: transparent !important;
    opacity: 0.75;
    cursor: default;
    touch-action: auto;
  }
  .ah-rack .ah-chip.ah-lock {
    padding: 0 4px !important;
    min-width: 28px;
  }
  .ah-chip.ah-mini {
    height: 26px;
    min-width: 26px;
    padding: 0 4px !important;
    border-radius: 8px;
    font-size: 11px;
    gap: 2px;
    box-shadow: 0 2px 0 color-mix(in srgb, var(--c) 35%, var(--ah-edge));
  }
  .ah-chip.ah-mini em {
    font-size: 9px;
    letter-spacing: -0.02em;
  }
  .ah-chip.ah-mini .ah-i {
    width: 15px;
    height: 15px;
  }
  .ah-dids {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-bottom: 12px;
  }
  .ah-did {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px 4px 7px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--c) 14%, var(--ah-tile));
    color: var(--c);
    font-size: 13px;
    font-weight: 700;
  }
  .ah-did .ah-i {
    width: 15px;
    height: 15px;
  }
  .ah-note header {
    color: var(--c, var(--ah-accent)) !important;
  }

  /* ---- window ---- */
  .ah-dock {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
  }
  .ah-winhead {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ah-mute);
    font-variant-numeric: tabular-nums;
  }
  .ah-clock {
    color: var(--ah-ink);
  }
  .ah .ah-winq {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    letter-spacing: inherit;
    text-transform: inherit;
    font-weight: inherit;
  }
  .ah-winq i {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--ah-tile);
    box-shadow: 0 1px 0 var(--ah-edge);
    font-style: normal;
    letter-spacing: 0;
  }
  .ah-legend {
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
    display: grid;
    gap: 10px;
    font-weight: 600;
  }
  .ah-legend li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ah-legend .ah-block {
    position: relative;
    flex: none;
    width: 44px;
    height: 32px;
    left: auto;
  }
  .ah-winhead .ah-bad {
    color: var(--ah-red);
  }
  .ah-win {
    position: relative;
    height: 40px;
    margin-top: 5px;
  }
  .ah-cells {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    gap: 2px;
  }
  .ah-cell {
    border-radius: 7px;
    background: color-mix(in srgb, var(--ah-edge) 38%, transparent);
  }
  .ah-blocks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .ah-block {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--x) / var(--n) * 100%);
    width: calc(var(--w) / var(--n) * 100% - 2px);
    border-radius: 7px;
    background: color-mix(in srgb, var(--ah-blue) 26%, var(--ah-tile));
    display: grid;
    place-items: center;
    color: color-mix(in srgb, var(--ah-ink) 55%, transparent);
    overflow: hidden;
  }
  .ah-block .ah-i {
    width: 14px;
    height: 14px;
  }
  .ah-block.ah-in {
    animation: ah-blockin 300ms var(--ah-ease) both;
  }
  .ah-block[class*="ah-c-"] {
    background: color-mix(in srgb, var(--c) 30%, var(--ah-tile));
  }
  /* what a part keeps in the window all the time: lighter, hatched */
  .ah-k-def,
  .ah-k-prompt,
  .ah-k-memory,
  .ah-k-skills,
  .ah-k-progress {
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--c) 24%, var(--ah-tile)) 0 5px,
