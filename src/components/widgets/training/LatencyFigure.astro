---
/**
 * Latency metrics on a timeline: time to first token (TTFT) and
 * time between tokens (TBT).
 *
 * Usage in an .mdx post:
 *   import LatencyFigure from "@/components/widgets/training/LatencyFigure.astro";
 *   <LatencyFigure />
 *
 * Props: caption (override, "" hides it), animate (false = static, no button).
 */
import Frame from "./Frame.astro";
type Props = { caption?: string; animate?: boolean };
const {
  caption = "After the prompt is sent, there is a longer wait for the first token (TTFT). After that, tokens stream in at a steadier pace, separated by the time between tokens (TBT).",
  animate = true,
} = Astro.props;
---

<Frame caption={caption} animate={animate}>
  <svg
    viewBox="0 64 720 162"
    role="img"
    aria-label="Timeline: the prompt is sent, there is a gap labelled time to first token, then tokens arrive one by one separated by the time between tokens"
  >
    <text class="lbl small muted" x="32" y="84" text-anchor="start"
      >prompt sent</text
    >
    <circle class="accent-fill" cx="40" cy="150" r="5"></circle>
    <line class="line" x1="40" y1="150" x2="700" y2="150"></line>
    <path class="line" d="M700,150 l-8,-5 M700,150 l-8,5"></path>
    <text class="lbl small muted" x="700" y="138" text-anchor="end">time</text>
    <text
      class="lbl small muted lat-wait"
      x="145.0"
      y="117"
      text-anchor="middle">processing the prompt…</text
    >
    <text class="lbl small muted" x="250" y="84">response streams in</text>
    <g class="lat-tok lat-t0">
      <rect class="accent-fill" x="250" y="96" width="52" height="32" rx="6"
      ></rect>
      <text
        class="lbl mono on-accent strong"
        x="276.0"
        y="117"
        text-anchor="middle">Hello</text
      >
      <line class="line thin" x1="250" y1="144" x2="250" y2="156"></line>
    </g>
    <g class="lat-tok lat-t1">
      <rect class="accent-soft" x="312" y="96" width="52" height="32" rx="6"
      ></rect>
      <text class="lbl mono" x="338.0" y="117" text-anchor="middle">!</text>
      <line class="line thin" x1="312" y1="144" x2="312" y2="156"></line>
    </g>
    <g class="lat-tok lat-t2">
      <rect class="accent-soft" x="374" y="96" width="52" height="32" rx="6"
      ></rect>
      <text class="lbl mono" x="400.0" y="117" text-anchor="middle">How</text>
      <line class="line thin" x1="374" y1="144" x2="374" y2="156"></line>
    </g>
    <g class="lat-tok lat-t3">
      <rect class="accent-soft" x="436" y="96" width="52" height="32" rx="6"
      ></rect>
      <text class="lbl mono" x="462.0" y="117" text-anchor="middle">can</text>
      <line class="line thin" x1="436" y1="144" x2="436" y2="156"></line>
    </g>
    <g class="lat-tok lat-t4">
      <rect class="accent-soft" x="498" y="96" width="52" height="32" rx="6"
      ></rect>
      <text class="lbl mono" x="524.0" y="117" text-anchor="middle">I</text>
      <line class="line thin" x1="498" y1="144" x2="498" y2="156"></line>
    </g>
    <g class="lat-tok lat-t5">
      <rect class="accent-soft" x="560" y="96" width="52" height="32" rx="6"
      ></rect>
      <text class="lbl mono" x="586.0" y="117" text-anchor="middle">help</text>
      <line class="line thin" x1="560" y1="144" x2="560" y2="156"></line>
    </g>
    <g class="lat-tok lat-t6">
      <rect class="accent-soft" x="622" y="96" width="52" height="32" rx="6"
      ></rect>
      <text class="lbl mono" x="648.0" y="117" text-anchor="middle">?</text>
      <line class="line thin" x1="622" y1="144" x2="622" y2="156"></line>
    </g>
    <path class="lat-brk ttft" d="M42,172 v6 H248 v-6"></path>
    <text class="lbl strong accent" x="145.0" y="200" text-anchor="middle"
      >TTFT</text
    >
    <text class="lbl small muted" x="145.0" y="218" text-anchor="middle"
      >time to first token</text
    >
    <path class="lat-brk" d="M252,172 v6 H310 v-6"></path>
    <path class="lat-brk dim" d="M314,172 v6 H372 v-6"></path>
    <path class="lat-brk dim" d="M376,172 v6 H434 v-6"></path>
    <path class="lat-brk dim" d="M438,172 v6 H496 v-6"></path>
    <path class="lat-brk dim" d="M500,172 v6 H558 v-6"></path>
    <path class="lat-brk dim" d="M562,172 v6 H620 v-6"></path>
    <text class="lbl strong accent" x="281.0" y="200" text-anchor="middle"
      >TBT</text
    >
    <text class="lbl small muted" x="254" y="218"
      >time between tokens (each gap)</text
    >
    <line class="lat-cur" x1="40" y1="70" x2="40" y2="160"></line>
  </svg>
</Frame>

<style is:global>
  @keyframes tf-lat-t0 {
    0%,
    22.9% {
      opacity: 0;
      transform: translateY(-8px);
    }
    24.9%,
    92% {
      opacity: 1;
      transform: none;
    }
    98%,
    100% {
      opacity: 0;
    }
  }
  .tf-anim:not(.is-static) .lat-t0 {
    animation: tf-lat-t0 9s linear infinite;
  }
  @keyframes tf-lat-t1 {
    0%,
    29.7% {
      opacity: 0;
      transform: translateY(-8px);
    }
    31.7%,
    92% {
      opacity: 1;
      transform: none;
    }
    98%,
    100% {
      opacity: 0;
    }
  }
  .tf-anim:not(.is-static) .lat-t1 {
    animation: tf-lat-t1 9s linear infinite;
  }
  @keyframes tf-lat-t2 {
    0%,
    36.4% {
      opacity: 0;
      transform: translateY(-8px);
    }
    38.4%,
    92% {
      opacity: 1;
      transform: none;
    }
    98%,
    100% {
      opacity: 0;
    }
  }
  .tf-anim:not(.is-static) .lat-t2 {
    animation: tf-lat-t2 9s linear infinite;
  }
  @keyframes tf-lat-t3 {
    0%,
    43.2% {
      opacity: 0;
      transform: translateY(-8px);
    }
    45.2%,
    92% {
      opacity: 1;
      transform: none;
    }
    98%,
    100% {
      opacity: 0;
    }
  }
  .tf-anim:not(.is-static) .lat-t3 {
    animation: tf-lat-t3 9s linear infinite;
  }
  @keyframes tf-lat-t4 {
    0%,
    50.0% {
      opacity: 0;
      transform: translateY(-8px);
    }
    52.0%,
    92% {
      opacity: 1;
      transform: none;
    }
    98%,
    100% {
      opacity: 0;
    }
  }
  .tf-anim:not(.is-static) .lat-t4 {
    animation: tf-lat-t4 9s linear infinite;
  }
  @keyframes tf-lat-t5 {
    0%,
    56.7% {
      opacity: 0;
      transform: translateY(-8px);
    }
    58.7%,
    92% {
      opacity: 1;
      transform: none;
    }
    98%,
    100% {
      opacity: 0;
    }
  }
  .tf-anim:not(.is-static) .lat-t5 {
    animation: tf-lat-t5 9s linear infinite;
  }
  @keyframes tf-lat-t6 {
    0%,
    63.5% {
      opacity: 0;
      transform: translateY(-8px);
    }
    65.5%,
    92% {
      opacity: 1;
      transform: none;
    }
    98%,
    100% {
      opacity: 0;
    }
  }
  .tf-anim:not(.is-static) .lat-t6 {
    animation: tf-lat-t6 9s linear infinite;
  }
  @keyframes tf-lat-cur {
    0% {
      transform: translateX(0);
      opacity: 1;
    }
    72% {
      transform: translateX(660px);
      opacity: 1;
    }
    80%,
    100% {
      transform: translateX(660px);
      opacity: 0;
    }
  }
  .tf-anim:not(.is-static) .lat-cur {
    animation: tf-lat-cur 9s linear infinite;
  }
  .tf-root:not(.tf-anim) .lat-cur,
  .tf-root.is-static .lat-cur {
    display: none;
  }
  @keyframes tf-lat-wait {
    0%,
    1% {
      opacity: 0;
    }
    3%,
    22.9% {
      opacity: 1;
    }
    25.9%,
    100% {
      opacity: 0.35;
    }
  }
  .tf-anim:not(.is-static) .lat-wait {
    animation: tf-lat-wait 9s linear infinite;
  }
  .tf-root .lat-brk {
    fill: none;
    stroke: var(--tf-accent);
    stroke-width: 2;
  }
  .tf-root .lat-brk.dim {
    stroke: var(--tf-line);
  }
  .tf-root .lat-brk.ttft {
    stroke-width: 2.5;
  }
  .tf-root .lat-cur {
    stroke: var(--tf-accent);
    stroke-width: 1.5;
    stroke-dasharray: 3 4;
  }
</style>
