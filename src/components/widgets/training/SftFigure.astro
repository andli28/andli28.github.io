---
/**
 * Base model vs. the same model after supervised fine-tuning.
 *
 * Usage in an .mdx post:
 *   import SftFigure from "@/components/widgets/training/SftFigure.astro";
 *   <SftFigure />
 *
 * Props: caption (override, "" hides it), animate (false = static, no button).
 */
import Frame from "./Frame.astro";
type Props = { caption?: string; animate?: boolean };
const {
  caption = "Supervised fine-tuning turns a text-continuer into an assistant by training on curated (prompt, ideal response) examples.",
  animate = true,
} = Astro.props;
---

<Frame caption={caption} animate={animate}>
  <svg
    viewBox="0 0 720 250"
    role="img"
    aria-label="Before fine-tuning the base model continues the pattern; after fine-tuning it answers the question"
  >
    <text class="lbl strong" x="180" y="24" text-anchor="middle"
      >Base model</text
    >
    <text class="lbl strong accent" x="540" y="24" text-anchor="middle"
      >After SFT</text
    >
    <line class="line divider" x1="360" y1="12" x2="360" y2="236"></line>
    {
      [0, 360].map(dx => (
        <g>
          <rect
            class="box"
            x={dx + 20}
            y="42"
            width="300"
            height="44"
            rx="12"
          />
          <text class="lbl small muted" x={dx + 34} y="60">
            User
          </text>
          <text class="lbl" x={dx + 34} y="78">
            What is the capital of France?
          </text>
        </g>
      ))
    }
    <g class="reply" style="--i:0">
      <rect class="muted-soft" x="40" y="104" width="300" height="104" rx="12"
      ></rect>
      <text class="lbl small muted" x="54" y="122">Model</text>
      <text class="lbl muted" x="54" y="144"
        >What is the capital of Germany?</text
      >
      <text class="lbl muted" x="54" y="166">What is the capital of Spain?</text
      >
      <text class="lbl muted" x="54" y="188">What is the capital of …</text>
    </g>
    <g class="reply" style="--i:1">
      <rect class="accent-soft" x="400" y="104" width="300" height="62" rx="12"
      ></rect>
      <text class="lbl small muted" x="414" y="122">Assistant</text>
      <text class="lbl" x="414" y="148">The capital of France is Paris.</text>
    </g>
    <text class="lbl small muted" x="180" y="234" text-anchor="middle"
      >continues text that looks similar</text
    >
    <text class="lbl small muted" x="540" y="234" text-anchor="middle"
      >answers like an assistant</text
    >
  </svg>
</Frame>
